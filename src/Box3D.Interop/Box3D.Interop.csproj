<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Box3D.Interop</RootNamespace>
    <AssemblyName>Box3D.Interop</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratorResponseFile>$(MSBuildThisFileDirectory)generate.rsp</GeneratorResponseFile>
    <GeneratedDir>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), 'Generated'))</GeneratedDir>
    <GeneratedStamp>$(GeneratedDir).stamp</GeneratedStamp>
  </PropertyGroup>

  <ItemGroup>
    <GeneratorInputs Include="$(GeneratorResponseFile);$(RepoRoot)native\box3d\include\box3d\*.h;$(RepoRoot).config\dotnet-tools.json" />
  </ItemGroup>

  <Target Name="GenerateInterop" BeforeTargets="BeforeBuild" Inputs="@(GeneratorInputs)" Outputs="$(GeneratedStamp)">
    <ItemGroup>
      <StaleGenerated Include="$(GeneratedDir)**\*.cs" />
    </ItemGroup>
    <Delete Files="@(StaleGenerated)" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(RepoRoot)" StandardOutputImportance="low" />
    <Exec Command="dotnet ClangSharpPInvokeGenerator &quot;@$(GeneratorResponseFile)&quot; --output &quot;$(GeneratedDir.TrimEnd('\'))&quot;" WorkingDirectory="$(RepoRoot)" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="GeneratorExitCode" />
    </Exec>
    <Error Condition="!Exists('$(GeneratedDir)Native.cs')" Text="ClangSharpPInvokeGenerator failed (exit code $(GeneratorExitCode))." />
    <Touch Files="$(GeneratedStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeGeneratedInterop" AfterTargets="GenerateInterop" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Compile Include="$(GeneratedDir)**\*.cs" />
    </ItemGroup>
  </Target>

</Project>
