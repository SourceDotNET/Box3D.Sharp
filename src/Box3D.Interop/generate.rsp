--language
c
--file-directory
native/box3d/include
--include-directory
native/box3d/include
--file
box3d/box3d.h
--traverse
native/box3d/include/box3d/base.h
native/box3d/include/box3d/box3d.h
native/box3d/include/box3d/collision.h
native/box3d/include/box3d/config.h
native/box3d/include/box3d/constants.h
native/box3d/include/box3d/id.h
native/box3d/include/box3d/math_functions.h
native/box3d/include/box3d/types.h
--namespace
Box3D.Interop
--method-class-name
Native
--library-path
box3d
--config
codegen=default
file=multi
types=windows
--generate
funcs-with-body=false
macro-bindings
disable-runtime-marshalling
file-scoped-namespaces
--exclude
b3Vec2
b3Vec3
b3Quat
b3Vec2_*
b3Vec3_*
b3Quat_*
b3Transform_*
b3Mat3_*
b3Pos_*
b3WorldTransform_*
--remap
b3Vec2=System.Numerics.Vector2
b3Vec3=System.Numerics.Vector3
b3Quat=System.Numerics.Quaternion
